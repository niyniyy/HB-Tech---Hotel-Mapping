# Copy this file to .env and fill in your values
# Never push .env to git

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5436/hotel_mapping
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5436/hotel_mapping

# Redis / Celery
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/1

# App
APP_NAME=HB Hotel Mapping Engine
APP_VERSION=1.0.0
DEBUG=True

# Embedding model + its decision band. Defaults are the BASE model's.
# To deploy the fine-tune, uncomment ALL THREE together — the band is calibrated
# to the model and the two must never move apart — then reset the pipeline and
# re-run it so every stored embedding is regenerated by the new model. Mixing
# vectors from two models is worse than using either one on its own.
# EMBEDDING_MODEL=models/hotel-minilm-ft
# AI_REJECT_BELOW=0.50
# AI_CONFIRM_AT=0.59

# LLM integration (Phase 1) — off by default; set LLM_ENABLED=True to turn on
LLM_ENABLED=False
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Your OpenAI key. Or leave blank and set OPENAI_API_KEY in the environment.
LLM_API_KEY=

# Geocoding validation (data quality) — off by default. Nominatim needs no key.
GEOCODING_ENABLED=False
GEOCODING_PROVIDER=nominatim
GEOCODING_API_KEY=
GEOCODING_MISMATCH_METERS=2000